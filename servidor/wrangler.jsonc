  "ratelimits": [
    {"name": "LIMITE_CONSULTAS", "namespace_id": "892671", "simple": {"limit": 30, "period": 60}},
    {"name": "LIMITE_ALTAS", "namespace_id": "892672", "simple": {"limit": 5, "period": 60}}
  ]
}
